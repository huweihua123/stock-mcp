# Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8000
CORS_ORIGINS=*

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# Data Source: Tushare (Required for A-Shares)
# Register at https://tushare.pro/
TUSHARE_TOKEN=

# Data Source: Finnhub (Optional, for US Stocks)
# Register at https://finnhub.io/
FINNHUB_API_KEY=

# Data Source: Baostock (Free, no key needed)
BAOSTOCK_ENABLED=True

# Proxy Configuration (Optional, for accessing foreign APIs like Yahoo/Finnhub from restricted regions)
PROXY_ENABLED=False
PROXY_HOST=127.0.0.1
PROXY_PORT=7890

# API Keys for News & Search (Optional)
# Used by NewsService and Research Tools
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=
TAVILY_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Web Search Provider (google / tavily)
WEB_SEARCH_PROVIDER=google

# =============================================================================
# Nacos MCP Server Configuration
# =============================================================================
# Enable this section for automatic service registration to Nacos

# Nacos Server Address
# Example: 127.0.0.1:8848 or nacos.example.com:8848
NACOS_SERVER_ADDR=127.0.0.1:8848

# Nacos Namespace
# Default: public
# You can create custom namespaces in Nacos Console for different environments
NACOS_NAMESPACE=public

# Nacos Authentication
# Default username/password for Nacos open-source version is nacos/nacos
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# MCP Server Name
# This name will be used to register the service in Nacos
# IMPORTANT: Java clients must use the exact same name to discover this service
NACOS_MCP_SERVER_NAME=stock-mcp-server

# MCP Server Version
# Version number for this MCP server
# IMPORTANT: Java clients must specify this exact version
NACOS_MCP_SERVER_VERSION=1.0.0

# MCP Server Port
# The port on which the MCP server will listen
NACOS_MCP_SERVER_PORT=18001

# MCP Transport Protocol
# Options:
#   - stdio: Standard Input/Output (synchronous, most stable)
#     Best for: Command-line tools, direct process communication
#   
#   - sse: Server-Sent Events (streaming, real-time)
#     Best for: Real-time streaming scenarios, WebSocket-like communication
#     Note: May have connection timeout issues with long-running operations
#   
#   - streamable-http: HTTP Long Polling (RECOMMENDED for Java clients)
#     Best for: Spring AI Alibaba clients, stable long-running operations
#     Note: Better handling of timeouts and retries
#
# RECOMMENDATION: Use 'streamable-http' for production Java clients
NACOS_MCP_TRANSPORT=streamable-http

# Enable/Disable Nacos Auto-Registration
# Set to false if you want to run the server without Nacos
NACOS_REGISTER_ENABLED=true

# =============================================================================
# Quick Start Guide for Nacos Integration
# =============================================================================
#
# 1. Start Nacos Server (if not already running):
#    Download from: https://nacos.io/download/nacos-server/
#    Start: sh startup.sh -m standalone
#
# 2. Copy this file to .env:
#    cp .env.example .env
#
# 3. Configure Nacos settings:
#    - Update NACOS_SERVER_ADDR if your Nacos is on a different host
#    - Set correct NACOS_USERNAME and NACOS_PASSWORD
#    - Choose appropriate NACOS_MCP_TRANSPORT (streamable-http recommended)
#
# 4. Fill in your API keys for data sources (Tushare, Finnhub, etc.)
#
# 5. Start the MCP Server:
#    ./start_nacos_mcp.sh
#
# 6. Verify Registration:
#    - Open Nacos Console: http://127.0.0.1:8848/nacos
#    - Login with nacos/nacos
#    - Navigate to: AI Services -> MCP Servers
#    - You should see 'stock-mcp-server' with 22 tools
#
# 7. Configure Java Client (Spring AI Alibaba):
#    See docs/JAVA_CLIENT_GUIDE.md for detailed instructions
#    Quick config in application.yml:
#
#    spring:
#      ai:
#        alibaba:
#          mcp:
#            nacos:
#              server-addr: 127.0.0.1:8848
#              namespace: public
#              username: nacos
#              password: nacos
#              client:
#                enabled: true
#                http:  # Use 'http' for streamable-http transport
#                  connections:
#                    stock:
#                      service-name: stock-mcp-server
#                      version: 1.0.0
#
# =============================================================================
# Available Tools (22 total)
# =============================================================================
#
# Asset Management (6 tools):
#   - search_assets: Search for stocks, ETFs, crypto, etc.
#   - get_asset_info: Get detailed asset information
#   - get_real_time_price: Get current price
#   - get_multiple_prices: Batch price queries
#   - get_historical_prices: Historical price data
#   - get_market_report: Comprehensive market report
#
# Technical Analysis (5 tools):
#   - calculate_technical_indicators: SMA, EMA, RSI, MACD, etc.
#   - generate_trading_signal: Generate buy/sell signals
#   - analyze_price_patterns: Detect price patterns
#   - calculate_support_resistance: Support and resistance levels
#   - analyze_volume_profile: Volume analysis
#
# Fundamental Analysis (1 tool):
#   - get_financial_report: Financial statements and ratios
#
# News & Research (3 tools):
#   - get_stock_news: Latest stock-specific news
#   - search_news: Search news by keyword
#   - perform_deep_research: Comprehensive research report
#
# Regulatory Filings (5 tools):
#   - fetch_sec_filings: US SEC filings (10-K, 10-Q, 8-K)
#   - fetch_ashare_filings: China A-share announcements
#   - get_filing_detail: Filing content details
#   - search_filings_by_keyword: Search filings
#   - get_latest_earnings_reports: Recent earnings reports
#
# Trading (2 tools):
#   - execute_order: Execute trades (simulation mode)
#   - get_account_balance: Get account balance (simulation)
#
# =============================================================================
# Troubleshooting
# =============================================================================
#
# Issue: Connection timeout or "ClosedResourceError"
# Solution: Change NACOS_MCP_TRANSPORT to 'streamable-http'
#
# Issue: "User not found" or 403 error
# Solution: Check NACOS_USERNAME and NACOS_PASSWORD
#
# Issue: Java client can't find service
# Solution: Verify service-name and version match exactly
#
# Issue: Tools not working
# Solution: Check API keys for data sources (Tushare, etc.)
#
# For more help, see:
# - README_NACOS.md
# - docs/JAVA_CLIENT_GUIDE.md
# - INTEGRATION_REPORT.md
#
# =============================================================================
