# Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8000
CORS_ORIGINS=*

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# PostgreSQL (Security Master)
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/valuecell
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=valuecell
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# Security Master backend (auto|postgres|sqlite)
SECURITY_MASTER_BACKEND=auto
SECURITY_MASTER_SQLITE_PATH=data/security_master.sqlite

# Data Source: Tushare (Optional, for A-Shares with higher priority)
# Register at https://tushare.pro/
# Set TUSHARE_ENABLED=True and provide token to enable
# If disabled, Akshare and Baostock will be used as fallback
TUSHARE_ENABLED=False
TUSHARE_TOKEN=

# Data Source: Finnhub (Optional, for US Stocks)
# Register at https://finnhub.io/
# Set FINNHUB_ENABLED=True and provide API key to enable
FINNHUB_ENABLED=False
FINNHUB_API_KEY=

# Data Source: Baostock (Free, no key needed)
BAOSTOCK_ENABLED=True

# Proxy Configuration (Optional, for accessing foreign APIs like Yahoo/Finnhub from restricted regions)
PROXY_ENABLED=False
PROXY_HOST=127.0.0.1
PROXY_PORT=7890

# API Keys for News & Search (Optional)
# Used by NewsService and Research Tools
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
NEWS_API_KEY=
TAVILY_API_KEY=
FRED_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Web Search Provider (google / tavily)
WEB_SEARCH_PROVIDER=google

# Logging
LOG_FILE=logs/stock-mcp.log
